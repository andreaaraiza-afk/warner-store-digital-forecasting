  "issues": [
    {
      "severity": "high",
      "area": "ux",
      "title": "Homepage largest paint is slow on both form factors",
      "detail": "Lab LCP is 8.7s on mobile (performance 41) and 9.0s on desktop (performance 27). TBT is 1417ms mobile and 1108ms desktop. TTFB is 18ms, so the wait is in the page, not the server."
    },
    {
      "severity": "high",
      "area": "seo",
      "title": "Collection pages and the cart have no meta description",
      "detail": "Empty descriptions on /collections/vinyl, /collections/music, /collections/apparel, /collections/best-sellers, /cart. Lighthouse flags meta-description on the vinyl collection and the cart. The homepage and product pages do have descriptions."
    },
    {
      "severity": "medium",
      "area": "ux",
      "title": "Cart and search shift layout",
      "detail": "CLS is at least 0.1 on collection desktop 0.121; search desktop 0.155; cart mobile 0.148; cart desktop 0.198. Homepage mobile CLS is 0."
    },
    {
      "severity": "medium",
      "area": "seo",
      "title": "Collections do not publish Collection or breadcrumb schema",
      "detail": "Product pages include Product schema (brand, GTIN, image). Collection pages in this sample only include Organization. No BreadcrumbList was found."
    },
    {
      "severity": "medium",
      "area": "seo",
      "title": "Some images ship an empty alt attribute",
      "detail": "Across the sampled pages, 25 images have alt=\"\". The homepage H1 is the logo image (alt Warner Records), not a text heading."
    },
    {
      "severity": "low",
      "area": "seo",
      "title": "Search results are noindex, which is why their SEO score is lower",
      "detail": "The vinyl search URL sends X-Robots-Tag: noindex, nofollow. That is a reasonable choice. It is not a broken title. The cart does not send noindex."
    },
    {
      "severity": "low",
      "area": "ux",
      "title": "Search and cart in the header are icon-only",
      "detail": "The public homepage screenshot shows Music, Apparel, and Best Sellers as text, and search and cart as icons. On a phone that is easy to miss."
    }
  ],
